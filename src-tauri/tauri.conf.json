{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTM Offline",
  "version": "1.0.0",
  "identifier": "io.github.doggylover314.ytmoffline",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "YTM Offline",
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Music",
    "license": "Apache-2.0",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3", "alsa-lib"],
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugin-libav"]
      },
      "deb": {
        "depends": ["libasound2t64 | libasound2"],
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
